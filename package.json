{
	"name": "grommunio-web",
	"version": "5.1.0",
	"description": "Main grommunio web client",
	"license": "AGPL-3.0",
	"repository": "https://github.com/grommunio/grommunio-web",
	"scripts": {
		"phplint": "phpmd server text .phpmd.xml || true",
		"lint": "eslint client/grommunio",
		"phplintci": "phpmd server xml .phpmd.xml --ignore-violations-on-exit | python tools/violations_to_junit.py > phpmd.xml",
		"build:pgp-vendor": "node tools/build-pgp-vendor.mjs",
		"test:pgp-browser": "node plugins/pgp/test/testBrowserCrypto.cjs && node plugins/pgp/test/testBrowserTransport.cjs",
		"sync:images": "node tools/sync-images.js --extract",
		"sync:images:report": "node tools/sync-images.js --report",
		"bom": "node tools/build-bom.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"globals": "^17.13.0"
	},
	"dependencies": {
		"cssnano": "^9.5.0",
		"fflate": "0.8.3",
		"glob": "^13.0.6",
		"html-minifier-terser": "^7.2.0",
		"openpgp": "6.3.2",
		"postal-mime": "2.7.5",
		"postcss": "^8.5.29",
		"postcss-cli": "^12.0.0",
		"postcss-preset-env": "^11.6.1",
		"svgo": "^4.1.0",
		"terser": "^5.21.0"
	}
}
