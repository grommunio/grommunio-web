msgid "Legal Information"
msgstr "Právne informácie"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "{0} ďalšie upozornenie"
msgstr[1] "{0} ďalšie upozornenia"

msgid "Show less"
msgstr "Zobraziť menej"

msgid "Undo and redo"
msgstr "Späť a znova"

msgid "Enable undo and redo of message actions"
msgstr "Povoliť funkcie Späť a Znova pre akcie so správami"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Vrátenie späť (Ctrl+Z) a opätovné vykonanie (Ctrl+Y) akcií, ako je odstránenie, presunutie alebo označenie správ príznakom. Zaznamenávanie týchto akcií spôsobuje malú dodatočnú záťaž, preto je táto funkcia predvolene vypnutá."

msgid "Undo"
msgstr "Späť"

msgid "Redo"
msgstr "Znova"

msgid "Undo: {0}"
msgstr "Späť: {0}"

msgid "Redo: {0}"
msgstr "Znova: {0}"

msgid "Nothing to undo"
msgstr "Nie je čo vrátiť späť"

msgid "Undo the last action"
msgstr "Vrátiť späť poslednú akciu"

msgid "Redo the last undone action"
msgstr "Znova vykonať poslednú vrátenú akciu"

msgid "Undo failed"
msgstr "Vrátenie späť zlyhalo"

msgid "Redo failed"
msgstr "Opätovné vykonanie zlyhalo"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nepodarilo sa vrátiť späť: {0}. Položka mohla byť medzitým presunutá, zmenená alebo odstránená."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nepodarilo sa znova vykonať: {0}. Položka mohla byť medzitým presunutá, zmenená alebo odstránená."

msgid "Delete {0}"
msgstr "Odstránenie {0}"

msgid "Delete {0} items"
msgstr "Odstránenie položiek ({0})"

msgid "Move {0} to {1}"
msgstr "Presunutie {0} do {1}"

msgid "Move {0} items to {1}"
msgstr "Presunutie položiek ({0}) do {1}"

msgid "Copy {0} to {1}"
msgstr "Skopírovanie {0} do {1}"

msgid "Copy {0} items to {1}"
msgstr "Skopírovanie položiek ({0}) do {1}"

msgid "Create {0}"
msgstr "Vytvorenie {0}"

msgid "Change flag"
msgstr "Zmena príznaku"

msgid "Change categories"
msgstr "Zmena kategórií"

msgid "Change appointment time"
msgstr "Zmena času plánovanej činnosti"

msgid "another folder"
msgstr "iného priečinka"

msgid "{0}: {1}"
msgstr "{0}: {1}"

msgid "{0}: {1} items"
msgstr "{0}: položky ({1})"

msgid "New mail from {0}"
msgstr "Nová pošta od {0}"

msgid "{0} new message in folder {1}"
msgid_plural "{0} new messages in folder {1}"
msgstr[0] "{0} nová správa v priečinku {1}"
msgstr[1] "{0} nové správy v priečinku {1}"

msgid "{0} new message in folder {1} of {2}"
msgid_plural "{0} new messages in folder {1} of {2}"
msgstr[0] "{0} nová správa v priečinku {1} používateľa {2}"
msgstr[1] "{0} nové správy v priečinku {1} používateľa {2}"

msgid "In folder {0}"
msgstr "V priečinku {0}"

msgid "In folder {0} of {1}"
msgstr "V priečinku {0} používateľa {1}"

msgid "New Mail Notifications"
msgstr "Upozornenia na novú poštu"

msgid "Only my own mailbox"
msgstr "Len moja vlastná poštová schránka"

msgid "Only the folders I choose"
msgstr "Len priečinky, ktoré vyberiem"

msgid "Unknown folder"
msgstr "Neznámy priečinok"

msgid "No folders selected, no new mail notification is shown."
msgstr "Nie sú vybrané žiadne priečinky, nezobrazí sa žiadne upozornenie na novú poštu."
