msgstr "{0}-г устгах"

msgid "Delete {0} items"
msgstr "{0} зүйлийг устгах"

msgid "Move {0} to {1}"
msgstr "{0}-г {1} руу зөөх"

msgid "Move {0} items to {1}"
msgstr "{0} зүйлийг {1} руу зөөх"

msgid "Copy {0} to {1}"
msgstr "{0}-г {1} руу хуулах"

msgid "Copy {0} items to {1}"
msgstr "{0} зүйлийг {1} руу хуулах"

msgid "Create {0}"
msgstr "{0}-г үүсгэх"

msgid "Change flag"
msgstr "Туг өөрчлөх"

msgid "Change categories"
msgstr "Ангилал өөрчлөх"

msgid "Change appointment time"
msgstr "Уулзалтын цагийг өөрчлөх"

msgid "another folder"
msgstr "өөр хавтас"

