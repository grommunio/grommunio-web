msgid "Legal Information"
msgstr "Informații de ordin juridic"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "încă {0} notificare"
msgstr[1] "încă {0} notificări"

msgid "Show less"
msgstr "Afișează mai puțin"

msgid "Undo and redo"
msgstr "Anulare și refacere"

msgid "Enable undo and redo of message actions"
msgstr "Activează anularea și refacerea acțiunilor asupra mesajelor"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Anularea (Ctrl+Z) și refacerea (Ctrl+Y) unor acțiuni precum ștergerea, mutarea sau semnalizarea mesajelor. Înregistrarea acestor acțiuni adaugă un mic consum suplimentar, de aceea funcția este dezactivată în mod implicit."

msgid "Undo"
msgstr "Anulare"

msgid "Redo"
msgstr "Refacere"

msgid "Undo: {0}"
msgstr "Anulare: {0}"

msgid "Redo: {0}"
msgstr "Refacere: {0}"

msgid "Nothing to undo"
msgstr "Nimic de anulat"

msgid "Undo the last action"
msgstr "Anulează ultima acțiune"

msgid "Redo the last undone action"
msgstr "Reface ultima acțiune anulată"

msgid "Undo failed"
msgstr "Anularea a eșuat"

msgid "Redo failed"
msgstr "Refacerea a eșuat"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nu s-a putut anula {0}. Este posibil ca elementul să fi fost mutat, modificat sau șters între timp."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nu s-a putut reface {0}. Este posibil ca elementul să fi fost mutat, modificat sau șters între timp."

