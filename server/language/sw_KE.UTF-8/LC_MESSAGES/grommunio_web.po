msgid "Legal Information"
msgstr "Maelezo ya kisheria"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "arifa {0} zaidi"
msgstr[1] "arifa {0} zaidi"

msgid "Show less"
msgstr "Onyesha kidogo"

msgid "Undo and redo"
msgstr "Kutendua na kurudia"

msgid "Enable undo and redo of message actions"
msgstr "Washa kutendua na kurudia vitendo vya ujumbe"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Kutendua (Ctrl+Z) na kurudia (Ctrl+Y) vitendo kama vile kufuta, kuhamisha au kuweka bendera kwenye jumbe. Kurekodi vitendo hivi huongeza mzigo mdogo, kwa hivyo kipengele hiki kimezimwa kwa chaguomsingi."

msgid "Undo"
msgstr "Tendua"

msgid "Redo"
msgstr "Rudia"

msgid "Undo: {0}"
msgstr "Tendua: {0}"

msgid "Redo: {0}"
msgstr "Rudia: {0}"

msgid "Nothing to undo"
msgstr "Hakuna cha kutendua"

msgid "Undo the last action"
msgstr "Tendua kitendo cha mwisho"

msgid "Redo the last undone action"
msgstr "Rudia kitendo cha mwisho kilichotenduliwa"

msgid "Undo failed"
msgstr "Kutendua kumeshindikana"

msgid "Redo failed"
msgstr "Kurudia kumeshindikana"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Imeshindikana kutendua {0}. Huenda kipengee kimehamishwa, kimebadilishwa au kimeondolewa tangu wakati huo."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Imeshindikana kurudia {0}. Huenda kipengee kimehamishwa, kimebadilishwa au kimeondolewa tangu wakati huo."

