msgid_plural "{0} new messages in folder {1} of {2}"
msgstr[0] "{0} նոր հաղորդագրություն {2}-ի {1} թղթապանակում"
msgstr[1] "{0} նոր հաղորդագրություն {2}-ի {1} թղթապանակում"

msgid "In folder {0}"
msgstr "{0} թղթապանակում"

msgid "In folder {0} of {1}"
msgstr "{1}-ի {0} թղթապանակում"
