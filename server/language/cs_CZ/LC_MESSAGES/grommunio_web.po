msgstr "Skrytí tlačítka na hlavním panelu nástrojů"

msgid "Add the subject to the room name"
msgstr "Přidání předmětu k názvu místnosti"

msgid "Add the organizer name to the room name"
msgstr "Přidání jména organizátora k názvu místnosti"

msgid "Add the URL to the meeting location rather than overwriting it"
msgstr "Přidání adresy URL do umístění schůzky namísto jejího přepsání"

msgid "Prevent the URL in the meeting location from being overridden automatically (ex: when adding a meetingroom)"
msgstr "Zabránit automatickému přepsání adresy URL v místě schůzky (např. při přidávání zasedací místnosti)"

msgid "If you have problems when creating meetings, try disabling this setting"
msgstr "Pokud máte při vytváření schůzek problémy, zkuste toto nastavení vypnout"

msgid "Add an invitation to the appointment description"
msgstr "Přidání pozvánky do popisu schůzky"

msgid "Invitation text (plain text)"
msgstr "Text pozvánky (prostý text)"

msgid "used when composing in plain text, must contain %url%, empty to reset to default"
msgstr "používá se při psaní v prostém textu, musí obsahovat %url%, prázdné pole obnoví výchozí nastavení"

