msgstr "{0} {1} फोल्डरमध्ये हलवा"

msgid "Move {0} items to {1}"
msgstr "{0} आयटम {1} फोल्डरमध्ये हलवा"

msgid "Copy {0} to {1}"
msgstr "{0} {1} फोल्डरमध्ये कॉपी करा"

msgid "Copy {0} items to {1}"
msgstr "{0} आयटम {1} फोल्डरमध्ये कॉपी करा"

