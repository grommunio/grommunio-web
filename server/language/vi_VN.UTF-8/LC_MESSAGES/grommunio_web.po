msgid "Legal Information"
msgstr "Thông tin pháp lý"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "{0} thông báo khác"
msgstr[1] "{0} thông báo khác"

msgid "Show less"
msgstr "Thu gọn"

msgid "Undo and redo"
msgstr "Hoàn tác và làm lại"

msgid "Enable undo and redo of message actions"
msgstr "Bật hoàn tác và làm lại các thao tác với thư"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Hoàn tác (Ctrl+Z) và làm lại (Ctrl+Y) các thao tác như xóa, di chuyển hoặc gắn cờ thư. Việc ghi lại các thao tác này tạo thêm một chút chi phí xử lý, do đó tính năng này bị tắt theo mặc định."

msgid "Undo"
msgstr "Hoàn tác"

msgid "Redo"
msgstr "Làm lại"

msgid "Undo: {0}"
msgstr "Hoàn tác: {0}"

msgid "Redo: {0}"
msgstr "Làm lại: {0}"

msgid "Nothing to undo"
msgstr "Không có gì để hoàn tác"

msgid "Undo the last action"
msgstr "Hoàn tác thao tác cuối cùng"

msgid "Redo the last undone action"
msgstr "Làm lại thao tác vừa hoàn tác"

msgid "Undo failed"
msgstr "Hoàn tác thất bại"

msgid "Redo failed"
msgstr "Làm lại thất bại"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Không thể hoàn tác {0}. Mục này có thể đã bị di chuyển, thay đổi hoặc xóa trong thời gian đó."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Không thể làm lại {0}. Mục này có thể đã bị di chuyển, thay đổi hoặc xóa trong thời gian đó."

msgid "Delete {0}"
msgstr "Xóa {0}"

