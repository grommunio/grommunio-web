msgstr "Xóa {0} mục"

msgid "Move {0} to {1}"
msgstr "Di chuyển {0} đến {1}"

msgid "Move {0} items to {1}"
msgstr "Di chuyển {0} mục đến {1}"

msgid "Copy {0} to {1}"
msgstr "Sao chép {0} vào {1}"

msgid "Copy {0} items to {1}"
msgstr "Sao chép {0} mục vào {1}"

msgid "Create {0}"
msgstr "Tạo {0}"

msgid "Change flag"
msgstr "Thay đổi cờ"

msgid "Change categories"
msgstr "Thay đổi danh mục"

msgid "Change appointment time"
msgstr "Thay đổi thời gian cuộc hẹn"

