msgid "Move {0} items to {1}"
msgstr "Premjesti stavke ({0}) u {1}"

msgid "Copy {0} to {1}"
msgstr "Kopiraj {0} u {1}"

msgid "Copy {0} items to {1}"
msgstr "Kopiraj stavke ({0}) u {1}"

msgid "Create {0}"
msgstr "Kreiraj {0}"

msgid "Change flag"
msgstr "Promijeni zastavicu"

msgid "Change categories"
msgstr "Promijeni kategorije"

msgid "Change appointment time"
msgstr "Promijeni vrijeme termina"

