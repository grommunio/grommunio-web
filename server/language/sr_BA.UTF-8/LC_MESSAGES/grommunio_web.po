msgid "Legal Information"
msgstr "Pravne informacije"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "još {0} obavještenje"
msgstr[1] "još {0} obavještenja"

msgid "Show less"
msgstr "Prikaži manje"

msgid "Undo and redo"
msgstr "Opozivanje i ponavljanje"

msgid "Enable undo and redo of message actions"
msgstr "Omogući opozivanje i ponavljanje radnji nad porukama"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Opozivanje (Ctrl+Z) i ponavljanje (Ctrl+Y) radnji kao što su brisanje, premještanje ili označavanje poruka zastavicom. Bilježenje ovih radnji stvara malo dodatno opterećenje, pa je funkcija podrazumijevano onemogućena."

msgid "Undo"
msgstr "Opozovi"

msgid "Redo"
msgstr "Ponovi"

msgid "Undo: {0}"
msgstr "Opozovi: {0}"

msgid "Redo: {0}"
msgstr "Ponovi: {0}"

msgid "Nothing to undo"
msgstr "Nema radnji za opozivanje"

msgid "Undo the last action"
msgstr "Opozovi posljednju radnju"

msgid "Redo the last undone action"
msgstr "Ponovi posljednju opozvanu radnju"

msgid "Undo failed"
msgstr "Opozivanje nije uspjelo"

msgid "Redo failed"
msgstr "Ponavljanje nije uspjelo"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nije moguće opozvati {0}. Stavka je u međuvremenu možda premještena, izmijenjena ili uklonjena."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nije moguće ponoviti {0}. Stavka je u međuvremenu možda premještena, izmijenjena ili uklonjena."

