msgstr "Mapē {0} ({1})"

msgid "New Mail Notifications"
msgstr "Paziņojumi par jaunu pastu"

msgid "Only my own mailbox"
msgstr "Tikai mana pastkaste"

msgid "Only the folders I choose"
msgstr "Tikai manis izvēlētās mapes"

