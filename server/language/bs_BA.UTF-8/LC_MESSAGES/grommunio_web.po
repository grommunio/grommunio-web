msgid "Legal Information"
msgstr "Pravne informacije"

msgid "{0} more notice"
msgid_plural "{0} more notices"
msgstr[0] "Još {0} obavijest"
msgstr[1] "Još {0} obavijesti"

msgid "Show less"
msgstr "Prikaži manje"

msgid "Undo and redo"
msgstr "Poništavanje i ponavljanje"

msgid "Enable undo and redo of message actions"
msgstr "Omogući poništavanje i ponavljanje radnji nad porukama"

msgid "Undo (Ctrl+Z) and redo (Ctrl+Y) of actions such as deleting, moving or flagging messages. Recording these actions adds a small overhead, therefore the feature is disabled by default."
msgstr "Poništavanje (Ctrl+Z) i ponavljanje (Ctrl+Y) radnji kao što su brisanje, premještanje ili označavanje poruka zastavicom. Bilježenje ovih radnji stvara malo dodatnog opterećenja, pa je ova funkcija podrazumijevano isključena."

msgid "Undo"
msgstr "Poništi"

msgid "Redo"
msgstr "Ponovi"

msgid "Undo: {0}"
msgstr "Poništi: {0}"

msgid "Redo: {0}"
msgstr "Ponovi: {0}"

msgid "Nothing to undo"
msgstr "Nema ništa za poništiti"

msgid "Undo the last action"
msgstr "Poništi posljednju radnju"

msgid "Redo the last undone action"
msgstr "Ponovi posljednju poništenu radnju"

msgid "Undo failed"
msgstr "Poništavanje nije uspjelo"

msgid "Redo failed"
msgstr "Ponavljanje nije uspjelo"

msgid "Could not undo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nije moguće poništiti: {0}. Stavka je u međuvremenu možda premještena, izmijenjena ili uklonjena."

msgid "Could not redo {0}. The item may have been moved, changed or removed in the meantime."
msgstr "Nije moguće ponoviti: {0}. Stavka je u međuvremenu možda premještena, izmijenjena ili uklonjena."

msgid "Delete {0}"
msgstr "Brisanje {0}"

msgid "Delete {0} items"
msgstr "Brisanje stavki ({0})"

msgid "Move {0} to {1}"
msgstr "Premještanje {0} u {1}"

msgid "Move {0} items to {1}"
msgstr "Premještanje stavki ({0}) u {1}"

msgid "Copy {0} to {1}"
msgstr "Kopiranje {0} u {1}"

msgid "Copy {0} items to {1}"
msgstr "Kopiranje stavki ({0}) u {1}"

msgid "Create {0}"
msgstr "Kreiranje {0}"

msgid "Change flag"
msgstr "Promjena zastavice"

msgid "Change categories"
msgstr "Promjena kategorija"

msgid "Change appointment time"
msgstr "Promjena vremena termina"

msgid "another folder"
msgstr "drugi folder"

msgid "{0}: {1}"
msgstr "{0}: {1}"

msgid "{0}: {1} items"
msgstr "{0}: stavke ({1})"

msgid "New mail from {0}"
msgstr "Nova pošta od {0}"

msgid "{0} new message in folder {1}"
msgid_plural "{0} new messages in folder {1}"
msgstr[0] "{0} nova poruka u folderu {1}"
msgstr[1] "{0} novih poruka u folderu {1}"

msgid "{0} new message in folder {1} of {2}"
msgid_plural "{0} new messages in folder {1} of {2}"
msgstr[0] "{0} nova poruka u folderu {1} korisnika {2}"
msgstr[1] "{0} novih poruka u folderu {1} korisnika {2}"

msgid "In folder {0}"
msgstr "U folderu {0}"

msgid "In folder {0} of {1}"
msgstr "U folderu {0} korisnika {1}"

msgid "New Mail Notifications"
msgstr "Obavijesti o novoj pošti"

msgid "Only my own mailbox"
msgstr "Samo moje vlastito poštansko sanduče"

msgid "Only the folders I choose"
msgstr "Samo folderi koje odaberem"

msgid "Unknown folder"
msgstr "Nepoznat folder"

msgid "No folders selected, no new mail notification is shown."
msgstr "Nijedan folder nije odabran, ne prikazuje se nikakva obavijest o novoj pošti."
