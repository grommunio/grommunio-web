msgid_plural "{0} new messages in folder {1}"
msgstr[0] "{0} neges newydd yn y ffolder {1}"
msgstr[1] "{0} neges newydd yn y ffolder {1}"

msgid "{0} new message in folder {1} of {2}"
msgid_plural "{0} new messages in folder {1} of {2}"
msgstr[0] "{0} neges newydd yn ffolder {1} y defnyddiwr {2}"
msgstr[1] "{0} neges newydd yn ffolder {1} y defnyddiwr {2}"

msgid "In folder {0}"
msgstr "Yn y ffolder {0}"

